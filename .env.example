VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Canonical site origin used for SEO metadata, Open Graph URLs, and sitemap links.
# Example production: https://kinesoscore.com
VITE_SITE_URL=https://kinesoscore.com

# Auth email redirects use window.location.origin at runtime:
# - Signup confirm:  {origin}/?type=signup
# - Password reset:  {origin}/reset-password?type=recovery
#
# In Supabase Dashboard → Authentication → URL Configuration, add:
# - Site URL: https://kinesoscore.com (production) or http://localhost:5173 (local)
# - Redirect URLs allow list:
#   http://localhost:5173/**
#   http://localhost:5174/**
#   https://kinesoscore.com/**
#
# SMTP (Resend + custom domain) is configured in the Supabase dashboard — not in this app.
